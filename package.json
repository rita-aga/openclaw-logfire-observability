{
  "name": "openclaw-logfire-observability",
  "version": "1.0.1",
  "type": "module",
  "description": "OpenClaw plugin for full observability in Pydantic Logfire — traces agent runs, tool calls, and messages via OpenTelemetry",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "logfire",
    "pydantic",
    "observability",
    "opentelemetry",
    "otel",
    "tracing",
    "agent",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rita-aga/openclaw-logfire-observability.git"
  },
  "license": "MIT",
  "author": "rita-aga",
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0"
  }
}
